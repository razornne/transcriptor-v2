# =============================================================================
# LOCAL DEVELOPMENT — скопируй в .env и заполни нужные поля
# В production все секреты живут в Modal Secret (modal secret create) и
# Vercel Environment Variables — .env на проде не используется.
# =============================================================================

# =============================================================================
# SUPABASE
# =============================================================================

# URL проекта Supabase — нужен и локально и в Modal Secret
# Найти: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://bmonakhktbaliwgobrxv.supabase.co

# Service Role Key — только бэкенд (НИКОГДА не в браузер)
# Обходит RLS, нужен для чтения/записи user_profiles и transcripts от имени сервера
# Найти: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anon Key — публичный, используется во фронтенде (templates/index.html)
# Уже хардкодом в index.html — здесь только для справки
# Найти: Supabase Dashboard → Project Settings → API → anon public key
# SUPABASE_ANON_KEY=eyJ...

# =============================================================================
# STRIPE (биллинг)
# =============================================================================

# Secret Key — только бэкенд
# Найти: Stripe Dashboard → Developers → API keys → Secret key
# Тест: sk_test_... | Прод: sk_live_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook Secret — для валидации подписи Stripe событий
# Найти: Stripe Dashboard → Developers → Webhooks → твой endpoint → Signing secret
# Локально: stripe listen --forward-to localhost:5000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs из Stripe Dashboard → Products → твой продукт → Pricing
# Создать отдельные цены для Pro Monthly / Pro Annual / Max Monthly / Max Annual
STRIPE_PRO_MONTHLY_PRICE=price_...
STRIPE_PRO_ANNUAL_PRICE=price_...
STRIPE_MAX_MONTHLY_PRICE=price_...
STRIPE_MAX_ANNUAL_PRICE=price_...

# =============================================================================
# GEMINI API (STT correction + summary/actions)
# =============================================================================

# Google AI Studio: https://aistudio.google.com/apikey
# Нужен billing в Google Cloud Console для доступа к Pro модели
# В Modal: живёт в transcriptor-secrets (modal secret create ... GEMINI_API_KEY=...)
GEMINI_API_KEY=AIza...

# =============================================================================
# HUGGINGFACE (только локальный режим)
# =============================================================================

# Нужен для загрузки pyannote speaker diarization модели
# 1) Создать на https://huggingface.co/settings/tokens (тип: Read)
# 2) Принять условия на https://huggingface.co/pyannote/speaker-diarization-3.1
# 3) Принять условия на https://huggingface.co/pyannote/speaker-diarization-community-1
# В Modal: живёт в transcriptor-secrets (HF_TOKEN=...)
HF_TOKEN=hf_...

# =============================================================================
# MODAL
# =============================================================================

# Раскомментировать чтобы использовать Modal GPU из локального Flask
# После `modal setup` и `modal deploy modal_app.py`
# USE_MODAL=true

# =============================================================================
# OVERRIDE DEFAULTS (опционально)
# =============================================================================

# Whisper модели (только локальный режим без Modal)
# WHISPER_MODEL=large-v3-turbo     # fast (default)
# WHISPER_BEST_MODEL=large-v3      # best quality (Max plan)
# WHISPER_DEVICE=cuda              # cuda / cpu
# WHISPER_COMPUTE=float16          # float16 (GPU) / int8 (CPU)

# Диаризация: smoothing коротких сегментов
# SMOOTH_THRESHOLD_S=1.0           # переназначать сегменты короче 1с (0 = выключено)

# Gemini модель для STT correction (override)
# CORRECTION_MODEL=gemini-2.5-flash    # default (fast, дешевле)
# CORRECTION_MODEL=gemini-2.5-pro      # лучше качество

# Ollama (только локальный режим)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
