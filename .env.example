# HuggingFace токен — нужен для pyannote.
# 1) Создать на https://huggingface.co/settings/tokens (тип: Read)
# 2) Принять условия модели на https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_...

# Опционально — переопределить дефолты транскрибера
# Дефолт: large-v3 (лучшее качество на UA/RU, ~3GB VRAM)
# WHISPER_MODEL=large-v3         # tiny / base / small / medium / large-v3 / large-v3-turbo
#                                # turbo быстрее, чуть хуже качество; medium — экономнее по VRAM
# WHISPER_DEVICE=cuda            # cuda / cpu
# WHISPER_COMPUTE=float16        # float16 (GPU) / int8 (CPU)

# Опционально — Ollama (LLM для title, summary, action items, chat)
# Используется только в локальном режиме (USE_MODAL не задан)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# Modal (облачный GPU) — раскомментировать чтобы включить
# После `modal setup` и `modal deploy modal_app.py`:
# USE_MODAL=true
#
# LLM модель в контейнере Modal (дефолт: aya-expanse-8b)
# LLM_MODEL=CohereForAI/aya-expanse-8b   # или Qwen/Qwen2.5-14B-Instruct
