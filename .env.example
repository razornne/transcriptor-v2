# HuggingFace токен — нужен для pyannote.
# 1) Создать на https://huggingface.co/settings/tokens (тип: Read)
# 2) Принять условия модели на https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_...

# Опционально — переопределить дефолты транскрибера
# WHISPER_MODEL=large-v3-turbo  # tiny / base / small / medium / large-v3 / large-v3-turbo
#                               # turbo — рекомендуется: меньше large-v3, быстрее, ~то же качество
# WHISPER_DEVICE=cuda            # cuda / cpu
# WHISPER_COMPUTE=float16        # float16 (GPU) / int8 (CPU)

# Опционально — Ollama (LLM для title, summary, action items, chat)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
